netcdf temperature {
dimensions:
    time = UNLIMITED ;
    lat = 3 ;
    lon = 4 ;
variables:
    double time(time) ;
        time:units = "days since 2000-01-01" ;
        time:calendar = "360_day" ;
        time:axis = "T" ;
    float lat(lat) ;
        lat:units = "degrees_north" ;
        lat:standard_name = "latitude" ;
    float lon(lon) ;
        lon:units = "degrees_east" ;
        lon:standard_name = "longitude" ;
    float temperature(time, lat, lon) ;
        temperature:long_name = "Example surface temperature" ;
        temperature:units = "degC" ;
        temperature:_FillValue = -9999.f ;
        temperature:valid_range = -5.f, 40.f ;

    :title = "A small dataset to explore" ;
    :Conventions = "CF-1.10" ;
    :description = "Synthetic data for testing NCDive; not observations." ;
data:
    time = 0, 30 ;
    lat = -60, 0, 60 ;
    lon = 0, 90, 180, 270 ;
    temperature =
        4, 5, 6, 7, 24, 25, _, 27, 8, 9, 10, 11,
        5, 6, 7, 8, 25, 26, _, 28, 9, 10, 11, 12 ;
}
